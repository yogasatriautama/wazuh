#!/var/ossec/framework/python/bin/python3
# -*- coding: utf-8 -*-

import os
import sys
import json
import time
import hashlib
import tempfile
from datetime import datetime

import requests
from requests.packages.urllib3.exceptions import InsecureRequestWarning

requests.packages.urllib3.disable_warnings(InsecureRequestWarning)

LOG_PREFIX = "custom-dfir_iris"
STATE_DIR = "/var/ossec/tmp"
DEDUP_DB = os.path.join(STATE_DIR, "custom-dfir_iris_dedup.json")

ALLOWED_RULE_IDS = {"100622", "100623"}

TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID = ""


def log(msg):
    print(f"{LOG_PREFIX}: {msg}", file=sys.stderr, flush=True)


def load_json(path, default=None):
    if default is None:
        default = {}
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def atomic_write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".tmp_", dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        os.replace(tmp, path)
    finally:
        try:
            if os.path.exists(tmp):
                os.unlink(tmp)
        except Exception:
            pass


def get_nested(obj, *keys, default=None):
    cur = obj
    for k in keys:
        if not isinstance(cur, dict):
            return default
        cur = cur.get(k)
        if cur is None:
            return default
    return cur


def safe_text(value, default="-", max_len=None):
    if value is None:
        text = default
    else:
        text = str(value).strip()
        if not text:
            text = default
    if max_len is not None:
        return text[:max_len]
    return text


def extract_ioc_value(alert):
    candidates = [
        get_nested(alert, "data", "misp", "value"),
        get_nested(alert, "data", "misp", "ioc"),
        get_nested(alert, "data", "ioc"),
        get_nested(alert, "data", "indicator"),
        get_nested(alert, "data", "match"),
        get_nested(alert, "data", "eventdata", "misp", "value"),
        get_nested(alert, "data", "threat", "indicator"),
        get_nested(alert, "win", "eventdata", "targetObject"),
        get_nested(alert, "syscheck", "value"),
        get_nested(alert, "full_log"),
    ]
    for item in candidates:
        if item:
            return safe_text(item, max_len=300)
    return "-"


def extract_src_ip(alert):
    return safe_text(
        get_nested(alert, "data", "srcip")
        or get_nested(alert, "data", "src_ip")
        or get_nested(alert, "srcip"),
        default="-",
        max_len=100,
    )


def extract_dst_ip(alert):
    return safe_text(
        get_nested(alert, "data", "dstip")
        or get_nested(alert, "data", "dst_ip")
        or get_nested(alert, "dstip"),
        default="-",
        max_len=100,
    )


def extract_user(alert):
    return safe_text(
        get_nested(alert, "data", "user")
        or get_nested(alert, "data", "username")
        or get_nested(alert, "win", "eventdata", "targetUserName"),
        default="-",
        max_len=150,
    )


def extract_groups(alert):
    groups = get_nested(alert, "rule", "groups", default=[])
    if isinstance(groups, list):
        return [safe_text(x) for x in groups if safe_text(x) != "-"]
    if groups:
        return [safe_text(groups)]
    return []


def extract_best_log(alert, max_len=1200):
    candidates = [
        get_nested(alert, "full_log"),
        get_nested(alert, "data", "win", "eventdata"),
        get_nested(alert, "data", "eventdata"),
        get_nested(alert, "data"),
    ]

    for item in candidates:
        if not item:
            continue

        if isinstance(item, str):
            return safe_text(item.replace("\\n", "\n"), default="-", max_len=max_len)

        if isinstance(item, (dict, list)):
            try:
                return safe_text(
                    json.dumps(item, ensure_ascii=False, indent=2),
                    default="-",
                    max_len=max_len
                )
            except Exception:
                pass

    return "-"


def build_fingerprint(alert):
    rule_id = safe_text(get_nested(alert, "rule", "id"), default="unknown")
    agent_name = safe_text(get_nested(alert, "agent", "name"), default="unknown-agent")
    src_ip = extract_src_ip(alert)
    ioc_value = extract_ioc_value(alert)
    base = f"{rule_id}|{agent_name}|{src_ip}|{ioc_value}"
    return hashlib.sha256(base.encode("utf-8")).hexdigest()


def dedup_seen_recently(fingerprint, ttl_seconds):
    now = int(time.time())
    db = load_json(DEDUP_DB, default={})

    cleaned = {}
    for k, v in db.items():
        if isinstance(v, int) and (now - v) < ttl_seconds:
            cleaned[k] = v

    if fingerprint in cleaned:
        atomic_write_json(DEDUP_DB, cleaned)
        return True

    cleaned[fingerprint] = now
    atomic_write_json(DEDUP_DB, cleaned)
    return False


def build_case_name(rule_desc, agent_name, ioc_value, max_len):
    base = f"[Wazuh][MISP] {ioc_value} on {agent_name}"
    if ioc_value == "-" or len(base) > max_len:
        base = f"[Wazuh][MISP] {rule_desc} on {agent_name}"
    return safe_text(base, max_len=max_len)


def build_case_description(alert):
    rule = alert.get("rule", {})
    agent = alert.get("agent", {})
    data = alert.get("data", {})

    rule_id = safe_text(rule.get("id"), default="unknown")
    rule_desc = safe_text(rule.get("description"), default="No description")
    level = int(rule.get("level", 0) or 0)
    wazuh_alert_id = safe_text(alert.get("id"), default="-")
    ts = safe_text(alert.get("timestamp"), default=datetime.utcnow().isoformat())
    agent_name = safe_text(agent.get("name"), default="unknown-agent")
    agent_id = safe_text(agent.get("id"), default="-")
    src_ip = extract_src_ip(alert)
    dst_ip = extract_dst_ip(alert)
    username = extract_user(alert)
    ioc_value = extract_ioc_value(alert)
    groups = rule.get("groups", [])
    if not isinstance(groups, list):
        groups = [safe_text(groups)]

    short = (
        f"MISP IOC hit detected by Wazuh on {agent_name}. "
        f"IOC={ioc_value}; src_ip={src_ip}; user={username}; "
        f"rule_id={rule_id}; alert_id={wazuh_alert_id}"
    )

    details = {
        "summary": short,
        "timestamp": ts,
        "wazuh_alert_id": wazuh_alert_id,
        "rule_id": rule_id,
        "rule_description": rule_desc,
        "rule_level": level,
        "rule_groups": groups,
        "agent_name": agent_name,
        "agent_id": agent_id,
        "src_ip": src_ip,
        "dst_ip": dst_ip,
        "user": username,
        "ioc_value": ioc_value,
        "data": data,
    }

    return (
        short
        + "\n\n"
        + "Raw context:\n"
        + "```json\n"
        + json.dumps(details, ensure_ascii=False, indent=2)
        + "\n```"
    )


def post_json(url, headers, payload, verify_ssl):
    r = requests.post(url, headers=headers, json=payload, timeout=30, verify=verify_ssl)
    if not r.ok:
        raise requests.HTTPError(f"{r.status_code} {r.reason}", response=r)
    try:
        return r.json()
    except Exception:
        return {"raw_text": r.text}


def parse_options(argv):
    options = {}
    if len(argv) > 4:
        try:
            options = json.loads(argv[4])
        except Exception as e:
            log(f"Failed to parse options JSON: {e}")
    return options


def telegram_enabled(bot_token, chat_id):
    return bool(str(bot_token).strip()) and bool(str(chat_id).strip())


def escape_html(text):
    text = str(text if text is not None else "")
    return (
        text.replace("&", "&amp;")
            .replace("<", "&lt;")
            .replace(">", "&gt;")
    )


def build_telegram_message(alert, case_id, case_name):
    rule_id = safe_text(get_nested(alert, "rule", "id"), default="unknown")
    rule_desc = safe_text(get_nested(alert, "rule", "description"), default="No description")
    level = safe_text(get_nested(alert, "rule", "level"), default="0")
    groups = extract_groups(alert)
    groups_text = ", ".join(groups) if groups else "-"

    agent_name = safe_text(get_nested(alert, "agent", "name"), default="unknown-agent")
    agent_id = safe_text(get_nested(alert, "agent", "id"), default="-")
    wazuh_alert_id = safe_text(alert.get("id"), default="-")
    timestamp = safe_text(alert.get("timestamp"), default="-")
    ioc_value = extract_ioc_value(alert)
    src_ip = extract_src_ip(alert)
    dst_ip = extract_dst_ip(alert)
    username = extract_user(alert)
    raw_log = extract_best_log(alert, max_len=1200)

    title = rule_desc
    subtitle = f"DFIR IRIS case created: {case_name}"

    msg = []
    msg.append(f"<b>Attack:</b> {escape_html(title)}")
    msg.append(f"<b>Case:</b> {escape_html(subtitle)}")
    msg.append("")

    if raw_log != "-":
        msg.append("<b>Log:</b>")
        msg.append(f"<pre>{escape_html(raw_log)}</pre>")

    msg.append(f"<b>Target / IOC:</b> <code>{escape_html(ioc_value)}</code>")
    msg.append(f"<b>IP Attacker:</b> <code>{escape_html(src_ip)}</code>")
    msg.append(f"<b>Dst IP:</b> <code>{escape_html(dst_ip)}</code>")
    msg.append(f"<b>User:</b> <code>{escape_html(username)}</code>")
    msg.append(f"<b>Groups:</b> {escape_html(groups_text)}")
    msg.append(f"<b>Rule:</b> {escape_html(rule_id)} (Level {escape_html(level)})")
    msg.append(f"<b>Agent:</b> {escape_html(agent_name)} ({escape_html(agent_id)})")
    msg.append(f"<b>IRIS Case ID:</b> <code>{escape_html(case_id)}</code>")
    msg.append(f"<b>Wazuh Alert ID:</b> <code>{escape_html(wazuh_alert_id)}</code>")
    msg.append(f"<b>Time:</b> {escape_html(timestamp)}")

    return "\n".join(msg)


def send_telegram_message(bot_token, chat_id, message, verify_ssl):
    if not telegram_enabled(bot_token, chat_id):
        log("Telegram disabled: bot token or chat id is empty")
        return False

    url = f"https://api.telegram.org/bot{bot_token}/sendMessage"
    payload = {
        "chat_id": str(chat_id),
        "text": message,
        "parse_mode": "HTML",
        "disable_web_page_preview": True,
    }

    r = requests.post(url, json=payload, timeout=30, verify=verify_ssl)
    if not r.ok:
        raise requests.HTTPError(f"{r.status_code} {r.reason}", response=r)

    try:
        data = r.json()
    except Exception:
        data = {"ok": False, "raw_text": r.text}

    if not data.get("ok"):
        raise RuntimeError(f"Telegram API error: {json.dumps(data, ensure_ascii=False)}")

    return True


def main():
    if len(sys.argv) < 4:
        log("Usage: custom-dfir_iris <alert_file> <api_key> <hook_url> [options_json]")
        sys.exit(1)

    alert_file = sys.argv[1]
    api_key = sys.argv[2]
    base_url = sys.argv[3].rstrip("/")
    options = parse_options(sys.argv)

    customer_id = int(options.get("customer_id", 1))
    cid = int(options.get("cid", 1))
    verify_ssl = bool(options.get("verify_ssl", False))
    dedup_seconds = int(options.get("dedup_seconds", 1800))
    max_case_name_len = int(options.get("max_case_name_len", 180))

    telegram_bot_token = safe_text(
        options.get("telegram_bot_token"),
        default=TELEGRAM_BOT_TOKEN
    )
    telegram_chat_id = safe_text(
        options.get("telegram_chat_id"),
        default=TELEGRAM_CHAT_ID
    )

    alert = load_json(alert_file, default={})
    if not alert:
        log("Alert JSON empty or unreadable")
        sys.exit(1)

    rule_id = safe_text(get_nested(alert, "rule", "id"), default="unknown")
    if rule_id not in ALLOWED_RULE_IDS:
        log(f"Skipping unsupported rule_id={rule_id}")
        sys.exit(0)

    fingerprint = build_fingerprint(alert)
    if dedup_seen_recently(fingerprint, dedup_seconds):
        log(f"Duplicate suppressed: {fingerprint}")
        sys.exit(0)

    rule_desc = safe_text(
        get_nested(alert, "rule", "description"),
        default="No description",
        max_len=120
    )
    agent_name = safe_text(
        get_nested(alert, "agent", "name"),
        default="unknown-agent",
        max_len=100
    )
    ioc_value = extract_ioc_value(alert)
    wazuh_alert_id = safe_text(alert.get("id"), default=f"{rule_id}-{int(time.time())}")

    case_name = build_case_name(rule_desc, agent_name, ioc_value, max_case_name_len)

    case_payload = {
        "case_soc_id": wazuh_alert_id,
        "case_customer": customer_id,
        "case_name": case_name,
        "case_description": build_case_description(alert),
    }

    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json",
        "Accept": "application/json",
    }

    case_url = f"{base_url}/manage/cases/add?cid={cid}"

    try:
        log(f"Creating case for rule_id={rule_id} alert_id={wazuh_alert_id}")
        resp = post_json(case_url, headers, case_payload, verify_ssl)
        log(f"IRIS response: {json.dumps(resp, ensure_ascii=False)}")

        status = safe_text(resp.get("status"), default="").lower()
        data = resp.get("data", {}) if isinstance(resp.get("data"), dict) else {}
        case_id = data.get("case_id")

        if status != "success" or not case_id:
            log("Create case response did not return success/case_id")
            sys.exit(1)

        log(f"Case created successfully. case_id={case_id}")

        if telegram_enabled(telegram_bot_token, telegram_chat_id):
            try:
                telegram_message = build_telegram_message(alert, case_id, case_name)
                send_telegram_message(
                    telegram_bot_token,
                    telegram_chat_id,
                    telegram_message,
                    verify_ssl
                )
                log("Telegram notification sent successfully")
            except Exception as tg_err:
                log(f"Telegram notification failed: {tg_err}")
        else:
            log("Telegram notification skipped (token/chat_id not set)")

        sys.exit(0)

    except requests.HTTPError as e:
        code = getattr(e.response, "status_code", "unknown")
        body = getattr(e.response, "text", "")
        log(f"HTTP error status={code} body={body}")
        sys.exit(1)
    except Exception as e:
        log(f"Unhandled error: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
