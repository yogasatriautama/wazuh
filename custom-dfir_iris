#!/var/ossec/framework/python/bin/python3
import sys
import json
import requests
import ipaddress
import logging
import hashlib
import os
from datetime import datetime

LOG_FILE = "/var/ossec/logs/integrations.log"
DEDUP_DIR = "/var/ossec/var/run/abuseipdb-report-cache"

logging.basicConfig(
    filename=LOG_FILE,
    level=logging.INFO,
    format="%(asctime)s %(levelname)s: %(message)s"
)

os.makedirs(DEDUP_DIR, exist_ok=True)


def is_public_ip(ip):
    try:
        return bool(ip) and ipaddress.ip_address(ip).is_global
    except ValueError:
        return False
    except Exception:
        return False


def safe_get(d, path, default=None):
    cur = d
    for key in path:
        if not isinstance(cur, dict):
            return default
        cur = cur.get(key)
        if cur is None:
            return default
    return cur


def map_categories(alert):
    rule_id = str(safe_get(alert, ["rule", "id"], ""))
    groups = safe_get(alert, ["rule", "groups"], []) or []
    desc = (safe_get(alert, ["rule", "description"], "") or "").lower()

    if "ssh" in desc or rule_id in {"5710", "5712", "100002", "100003"}:
        return "18,22"   # Brute-Force + SSH
    if "sql injection" in desc:
        return "16"      # SQL Injection
    if "xss" in desc:
        return "21"      # Web App Attack
    if "web" in desc or "wordpress" in desc or "cms" in desc:
        return "21"      # Web App Attack
    if "scan" in desc or "recon" in groups:
        return "14"      # Port Scan
    if "bot" in desc:
        return "19"      # Bad Web Bot

    return "15"          # Hacking


def classify_attack_label(alert):
    rule_id = str(safe_get(alert, ["rule", "id"], ""))
    groups = safe_get(alert, ["rule", "groups"], []) or []
    desc = (safe_get(alert, ["rule", "description"], "") or "").lower()

    if "ssh" in desc or rule_id in {"5710", "5712", "100002", "100003"}:
        return "SSH brute-force activity"
    if "sql injection" in desc:
        return "SQL injection attempt"
    if "xss" in desc:
        return "Cross-site scripting attempt"
    if "web" in desc or "wordpress" in desc or "cms" in desc:
        return "Web application attack"
    if "scan" in desc or "recon" in groups:
        return "Port scanning or reconnaissance"
    if "bot" in desc:
        return "Bad web bot activity"

    return "Suspicious malicious activity"


def build_comment(alert):
    return classify_attack_label(alert)[:1024]


def dedup_key(alert, srcip):
    rule_id = str(safe_get(alert, ["rule", "id"], "0"))
    day = datetime.utcnow().strftime("%Y-%m-%d")
    raw = f"{srcip}|{rule_id}|{day}"
    return hashlib.sha256(raw.encode()).hexdigest()


def already_reported_today(alert, srcip):
    path = os.path.join(DEDUP_DIR, dedup_key(alert, srcip))

    try:
        if os.path.exists(path):
            return True

        with open(path, "w", encoding="utf-8") as f:
            f.write(datetime.utcnow().isoformat())
    except Exception as e:
        logging.warning("[abuseipdb] Dedup cache issue for %s: %s", srcip, e)

    return False


def main():
    if len(sys.argv) < 4:
        logging.error("[abuseipdb] Usage: custom-abuseipdb-report <alert_file> <api_key> <hook_url>")
        sys.exit(1)

    alert_file = sys.argv[1]
    api_key = sys.argv[2]
    hook_url = sys.argv[3]

    try:
        with open(alert_file, "r", encoding="utf-8") as f:
            alert = json.load(f)
    except Exception as e:
        logging.error("[abuseipdb] Failed to read alert file: %s", e)
        sys.exit(1)

    srcip = safe_get(alert, ["data", "srcip"]) or safe_get(alert, ["srcip"])
    if not is_public_ip(srcip):
        logging.info("[abuseipdb] Skipping non-public or invalid IP: %s", srcip)
        sys.exit(0)

    if already_reported_today(alert, srcip):
        logging.info(
            "[abuseipdb] Duplicate report skipped for ip=%s rule_id=%s",
            srcip,
            safe_get(alert, ["rule", "id"], "N/A")
        )
        sys.exit(0)

    categories = map_categories(alert)
    comment = build_comment(alert)

    headers = {
        "Key": api_key,
        "Accept": "application/json"
    }

    data = {
        "ip": srcip,
        "categories": categories,
        "comment": comment
    }

    logging.info(
        "[abuseipdb] Reporting ip=%s categories=%s rule_id=%s comment=%s",
        srcip,
        categories,
        safe_get(alert, ["rule", "id"], "N/A"),
        comment
    )

    try:
        resp = requests.post(hook_url, headers=headers, data=data, timeout=15)
        logging.info("[abuseipdb] Response status=%s body=%s", resp.status_code, resp.text)

        if resp.status_code in (200, 201):
            logging.info("[abuseipdb] Reported IP %s successfully", srcip)
        else:
            logging.error(
                "[abuseipdb] Failed reporting IP %s. Status=%s Body=%s",
                srcip,
                resp.status_code,
                resp.text
            )
            sys.exit(1)

    except Exception as e:
        logging.exception("[abuseipdb] Exception reporting IP %s: %s", srcip, e)
        sys.exit(1)


if __name__ == "__main__":
    main()
